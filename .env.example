# ---- LLM (paper: DeepSeek) --------------------------------------------------
# Leave empty to run with the offline rule-based MockLLM (pipeline test only).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
STAGE1_MODEL=deepseek-chat        # stage 1 fallback when no LoRA adapter is available
STAGE2_MODEL=deepseek-chat        # stage 2: refinement with the large model
STAGE1_BACKEND=auto               # auto = use outputs/lora_adapter when trained; lora = require adapter
LORA_BASE_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-8B
# LORA_ADAPTER_DIR=outputs/lora_adapter
# Optional: run stage 1 on a local small model through an OpenAI-compatible server (e.g. Ollama)
# STAGE1_BASE_URL=http://localhost:11434/v1
# STAGE1_API_KEY=ollama
# STAGE1_MODEL=deepseek-r1:8b
# LLM_BACKEND=auto                # auto | deepseek | ollama | local | mock
# For Ollama's native API, prefer this backend (disables reasoning and requests JSON):
# LLM_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# STAGE1_MODEL=qwen2.5:1.5b       # small CPU-friendly option; 3b is slower but often stronger
# OLLAMA_STAGE2_MODEL=deepseek-r1:14b   # larger refinement model; pull with `ollama pull deepseek-r1:14b`
# OLLAMA_NUM_PREDICT=256
# LLM_TIMEOUT=180
# OPT_DEV_SIZE=40                 # expert-annotated development examples
# OPT_MAX_ITERS=3                 # up to three feedback updates (four evaluations)
# OPT_USE_RAG=1                   # include fuzzy retrieval context during optimization
#   local = small open model run BY THE PROJECT (free, no key):  LLM_BACKEND=local  +  LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# ---- embeddings -------------------------------------------------------------
EMBEDDING_BACKEND=m3e             # paper-aligned M3E-Base (768-d); hash is only for explicit offline tests

# ---- Neo4j ------------------------------------------------------------------
USE_NEO4J=auto                    # auto | 1 (required) | 0 (never)
NEO4J_GRAPH_SCOPE=default         # managed graph replaced by build-kg; other scopes remain untouched
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ---- images -----------------------------------------------------------------
# Paper hosts images in a GitHub repo to get stable URLs. Default serves them from the local Flask API.
# IMAGE_BASE_URL=https://raw.githubusercontent.com/<you>/<repo>/main/images

# ---- tunables not given in the paper ----------------------------------------
# H_MIN=2.6                       # base entropy threshold. English short sentences ~2.6; Chinese (per-character) ~4.0
# SIGMA_S=0.1                     # variance weight in Eq. 29
# LAMBDA_STORAGE=0.01             # lambda in Eq. 12

# ---- parser filters / local LLM ---------------------------------------------
# MIN_IMAGE_PX=120                # drop images smaller than this (logos, icons)
# IMAGE_REQUIRE_CAPTION=1         # keep only figures/tables that have a caption
# LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct   # or Qwen/Qwen2.5-0.5B-Instruct (faster), 3B/7B (needs GPU)
# LOCAL_MAX_NEW_TOKENS=400
