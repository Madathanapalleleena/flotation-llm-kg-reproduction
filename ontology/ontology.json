{
  "name": "FlotationKnowledgeTree",
  "entity_types": [
    {
      "name": "RawOre",
      "description": "ore, minerals and feed characteristics (grade, particle size)"
    },
    {
      "name": "ProcessStage",
      "description": "flotation stage: fast roughing, roughing, scavenging, cleaning"
    },
    {
      "name": "Equipment",
      "description": "cells, agitators, pumps, scrapers, blowers, sensors"
    },
    {
      "name": "Parameter",
      "description": "process/operating parameters and froth indicators (pH, pulp concentration, aeration rate, froth depth, foam colour)"
    },
    {
      "name": "Reagent",
      "description": "collectors, frothers, activators, depressants, regulators"
    },
    {
      "name": "Product",
      "description": "concentrate, tailing and product quality/output indicators (grade, recovery, efficiency)"
    }
  ],
  "relation_types": [
    {
      "name": "affects",
      "description": "A influences B without a stated direction"
    },
    {
      "name": "increases",
      "description": "A raises / improves B"
    },
    {
      "name": "decreases",
      "description": "A lowers / reduces B"
    },
    {
      "name": "keeps",
      "description": "A holds B constant / stable"
    },
    {
      "name": "causes",
      "description": "A leads to / results in B"
    },
    {
      "name": "uses",
      "description": "A uses / is dosed with / is added to B"
    },
    {
      "name": "produces",
      "description": "A yields / generates B"
    },
    {
      "name": "follows",
      "description": "A comes after / flows into B in the process"
    },
    {
      "name": "has_property",
      "description": "A has attribute / state / location B"
    }
  ],
  "relation_constraints": {
    "uses": {
      "subject_types": ["ProcessStage", "Equipment"],
      "object_types": ["Reagent", "Equipment", "Parameter"]
    },
    "produces": {
      "subject_types": ["ProcessStage", "Equipment"],
      "object_types": ["Product", "RawOre"]
    },
    "follows": {
      "subject_types": ["ProcessStage"],
      "object_types": ["ProcessStage"]
    }
  },
